name: Build canonical public site

on:
  push:
    branches: [main]
    paths:
      - version.json
      - catalog-v32.js
      - catalog-services-v42/**
      - visual-v39.css
      - visual-v39.js
      - assets/**
      - scripts/build_catalog_shells.py
      - scripts/render_catalog_static.mjs
      - scripts/render_services_v42.mjs
      - scripts/enrich_editorial_pages.py
      - scripts/sync_public_version.py
      - scripts/apply_visual_assets.py
      - .github/workflows/build-canonical.yml
  workflow_dispatch:

concurrency:
  group: meridiano-canonical-build
  cancel-in-progress: true

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - name: Checkout current main
        uses: actions/checkout@v6
        with:
          fetch-depth: 0
      - name: Generate catalog shells
        run: python3 scripts/build_catalog_shells.py
      - name: Pre-render product catalog
        run: node scripts/render_catalog_static.mjs
      - name: Pre-render service catalog v4.2
        run: node scripts/render_services_v42.mjs
      - name: Enrich editorial pages
        run: python3 scripts/enrich_editorial_pages.py
      - name: Synchronize public version
        run: python3 scripts/sync_public_version.py
      - name: Apply canonical visual system
        run: python3 scripts/apply_visual_assets.py
      - name: Commit canonical outputs
        run: |
          if git diff --quiet; then
            echo "Canonical public files are current."
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A -- assets index.html firma.html perspectivas.html experiencia.html demo.html 404.html aviso-legal.html privacidad.html terminos.html catalog-home-v32.js decision-flow.js servicios productos perspectivas sectores page-context.js manifest.webmanifest scripts/build_catalog_shells.py
          git commit -m "build: sincroniza sitio público canónico"
          git pull --rebase origin main
          git push origin HEAD:main
