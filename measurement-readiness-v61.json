{
  "version": "6.1.0",
  "state": "readiness-disabled",
  "purpose": "Preparar medición agregada del funnel sin transportar PII, contenido del formulario, referencias de handoff ni identificadores propios de usuario.",
  "activation": {
    "production_enabled": false,
    "requires_explicit_provider": true,
    "requires_real_site_id": true,
    "requires_real_script_url": true,
    "requires_privacy_policy_update_before_enable": true
  },
  "privacy": {
    "pii_allowed": false,
    "form_content_allowed": false,
    "handoff_reference_allowed": false,
    "event_properties_allowed": false,
    "persistent_storage_introduced": false,
    "cross_session_identifier_introduced": false,
    "fingerprinting_introduced": false,
    "cookies_introduced_by_meridiano_adapter": false
  },
  "external_events": [
    "meridiano_funnel_need",
    "meridiano_funnel_offer",
    "meridiano_funnel_evidence",
    "meridiano_funnel_decision",
    "meridiano_funnel_contact",
    "meridiano_funnel_handoff"
  ],
  "stage_map": {
    "need": "meridiano_funnel_need",
    "offer": "meridiano_funnel_offer",
    "evidence": "meridiano_funnel_evidence",
    "decision": "meridiano_funnel_decision",
    "contact": "meridiano_funnel_contact",
    "handoff": "meridiano_funnel_handoff"
  },
  "providers": {
    "plausible": {
      "status": "supported-not-configured",
      "script_host": "plausible.io",
      "script_path_prefix": "/js/pa-",
      "custom_event_call": "plausible(eventName)",
      "notes": "Requiere el snippet único del sitio suministrado por Plausible. No se activa sin URL real."
    },
    "umami": {
      "status": "supported-not-configured",
      "script_host_policy": "explicit-https-host",
      "custom_event_call": "umami.track(eventName)",
      "notes": "Requiere URL HTTPS del tracker y website-id real. No se activa sin ambos."
    }
  },
  "semantic_limits": {
    "event_count_is_not_unique_people": true,
    "contact_is_not_message_sent": true,
    "handoff_is_not_message_delivered": true,
    "handoff_is_not_proposal_accepted": true,
    "handoff_is_not_client_conversion": true
  }
}
